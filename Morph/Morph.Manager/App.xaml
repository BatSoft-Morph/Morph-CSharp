<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Morph.Manager.Converters"
             x:Class="Morph.Manager.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="AccentColour">#1B2A4A</Color>
            <Color x:Key="HeaderTextColour">White</Color>

            <conv:BoolToIconConverter x:Key="BoolToIcon" />
            <conv:BoolToIconColourConverter x:Key="BoolToIconColour" />

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource AccentColour}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16,8" />
            </Style>

            <Style TargetType="Label" x:Key="ColumnHeader">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource HeaderTextColour}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
