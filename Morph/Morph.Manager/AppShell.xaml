<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Morph.Manager.Views"
       x:Class="Morph.Manager.AppShell"
       Title="Morph Manager">
    <TabBar>
        <ShellContent Title="Services"
                      ContentTemplate="{DataTemplate views:ServicesPage}"
                      Route="services" />
        <ShellContent Title="Startups"
                      ContentTemplate="{DataTemplate views:StartupsPage}"
                      Route="startups" />
    </TabBar>
</Shell>
