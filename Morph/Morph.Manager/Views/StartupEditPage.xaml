<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Morph.Manager.Views.StartupEditPage"
             Title="Startup">
    <VerticalStackLayout Padding="24" Spacing="12" MaximumWidthRequest="560">

        <Label Text="Service name" />
        <Entry x:Name="entryServiceName" TextChanged="OnAnythingChanged" />

        <Label Text="Application file" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="entryFileName" Grid.Column="0" TextChanged="OnAnythingChanged" />
            <Button Grid.Column="1" Text="Browse…" Clicked="OnBrowseClicked" />
        </Grid>

        <Label Text="Command line parameters" />
        <Entry x:Name="entryParameters" />

        <Label Text="Startup timeout (seconds)" />
        <HorizontalStackLayout Spacing="12">
            <Stepper x:Name="stepperTimeout" Minimum="1" Maximum="600" Increment="1" ValueChanged="OnTimeoutChanged" />
            <Label x:Name="labelTimeout" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="8" HorizontalOptions="End" Margin="0,16,0,0">
            <Button x:Name="butOK" Text="OK" Clicked="OnOKClicked" />
            <Button Text="Cancel" Clicked="OnCancelClicked" />
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>
