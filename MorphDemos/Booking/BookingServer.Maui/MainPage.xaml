<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookingServer.Maui.MainPage"
             Title="Booking Server">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Label Grid.Row="0" Text="Morph — Booking demo server" FontSize="20" FontAttributes="Bold" />
        <Label Grid.Row="1" x:Name="StatusLabel" Text="Starting…" />

        <!-- The live registration tree:  each booked object, and the queue of clients waiting for it -->
        <CollectionView Grid.Row="2" x:Name="BookingTree" IsGrouped="True">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding ObjectName}" FontAttributes="Bold" FontSize="16" Padding="0,10,0,2" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding}" Padding="16,2,0,2" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="No objects booked yet." />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
